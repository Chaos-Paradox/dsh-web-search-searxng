{
  "name": "dsh-web-search-searxng",
  "description": "SearXNG-backed self-hosted metasearch provider for DeepSeek Harness (ctx.web), with a Plugins-page settings card",
  "version": "0.2.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml",
      "configEffects": [
        {
          "id": "web",
          "set": {
            "searchProvider": "searxng"
          }
        },
        {
          "id": "web-search-searxng",
          "set": {
            "allowOfficialFallback": false
          },
          "track": [
            "baseURL",
            "engines",
            "language",
            "allowOfficialFallback"
          ]
        }
      ]
    }
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.client.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "lib/index.js",
    "lib/index.d.ts",
    "cordis.patch.yml",
    "lib/client.js",
    "lib/client.js.map",
    "lib/client/**/*.d.ts",
    "host-integration/dsh-config-effects.patch",
    "host-integration/README.md"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19 || >=24"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-launch-environment": ">=0.1.7-rc.1",
    "@deepseek-ai/dsh-web": ">=0.1.7-rc.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-locale": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-store": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-test-runtime": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-http-proxy": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-launch-environment": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-util-code-language": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-util-workspace-path": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-web": "0.2.1-alpha.1",
    "@shikijs/langs": "^4.5.0",
    "@testing-library/react": "^16.1.0",
    "@types/react": "~18.3.1",
    "@types/use-sync-external-store": "^1.7.0",
    "anser": "^2.3.5",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "immer": "^11.1.21",
    "jsdom": "^26.1.0",
    "katex": "^0.19.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-core-commonmark": "^2.0.4",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-factory-space": "^2.1.0",
    "micromark-util-character": "^2.1.1",
    "micromark-util-classify-character": "^2.0.1",
    "micromark-util-sanitize-uri": "^2.0.1",
    "micromark-util-symbol": "^2.0.1",
    "react": "^18.2.0",
    "shiki": "^4.5.0",
    "simple-icons": "^16.34.0",
    "tsdown": "^0.22.2",
    "typescript": "~6.0.3",
    "use-sync-external-store": "^1.7.0",
    "vitest": "^4.1.8",
    "zustand": "~4.4.7",
    "yaml": "^2.9.1"
  }
}
