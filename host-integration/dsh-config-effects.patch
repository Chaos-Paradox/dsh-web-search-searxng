+/** Actual out-of-tree bundle, Loader and config-editor lifecycle; network calls are fixtures. */
+import { mkdirSync, mkdtempSync, readFileSync, realpathSync, rmSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { dirname, join } from 'node:path'
+import { pathToFileURL } from 'node:url'
+import { expect, it, onTestFinished, vi } from 'vitest'
+import type { Context, Plugin } from '@deepseek-ai/cordis'
+import ConfigEditor from '@deepseek-ai/dsh-config-editor'
+import WebRuntime, { type WebSearchProvider } from '@deepseek-ai/dsh-web'
+import { boot, initProfile, planProfileConfigEffects, readProfilePatches, readProfileManifest, reconcileProfilePatches, type ProfileContext } from '../src/index.ts'
+
+it.skipIf(process.env.SEARXNG_PLUGIN_ENTRY === undefined)('restores an out-of-tree SearXNG installation after real card writes and fallback calls', async () => {
+  const entry = process.env.SEARXNG_PLUGIN_ENTRY!
+  const searxng: Plugin = await import(/* @vite-ignore */ pathToFileURL(entry).href)
+  const metadata = readProfileManifest('test', join(dirname(entry), '..'))
+  const home = realpathSync(mkdtempSync(join(tmpdir(), 'searxng-real-profile-')))
+  const dir = join(home, 'profiles/test')
+  const anchor = join(home, 'package.json')
+  onTestFinished(() => { rmSync(home, { recursive: true, force: true }) })
+  writeFileSync(anchor, '{}\n')
+  initProfile(dir, ['base', 'searxng'])
+  writeFileSync(join(dir, 'cordis.yml'), '[]\n')
+  function bundle(name: string, rows: object[], configEffects?: unknown) {
+    const packageDir = join(dir, 'node_modules', name)
+    mkdirSync(packageDir, { recursive: true })
+    writeFileSync(join(packageDir, 'package.json'), JSON.stringify({ name, version: '1.0.0', dsh: { bundle: { patch: 'cordis.patch.yml', configEffects } } }))
+    writeFileSync(join(packageDir, 'cordis.patch.yml'), JSON.stringify([{ insert: rows }]))
+  }
+  bundle('base', [
+    { id: 'config-editor', name: 'cordis:editor' },
+    { id: 'web', name: 'cordis:web', config: { searchProvider: 'deepseek-official', fetchProvider: 'http' } },
+    { id: 'original-provider', name: 'cordis:original' },
+    { id: 'official-provider', name: 'cordis:official' },
+  ])
+  bundle('searxng', [{ id: 'web-search-searxng', name: 'cordis:searxng' }], metadata.dsh?.bundle?.configEffects)
+  const original = '- id: web\n  config:\n    searchProvider: custom-original\n    fetchProvider: custom-fetch\n'
+  const patchPath = join(dir, 'cordis.patch.yml')
+  writeFileSync(patchPath, original)
+  const plan = planProfileConfigEffects(dir, anchor, ['base', 'searxng'])
+  writeFileSync(patchPath, plan.after)
+  const profile: ProfileContext = { name: 'test', startedBundles: ['base', 'searxng'], dir, patchPath, installAnchor: anchor, cwd: home, home, overlays: [], telemetryDisabledEnv: undefined }
+  const officialSearch = vi.fn(async () => ({ content: 'official', sources: [], truncated: false }))
+  const register = (id: string, search: WebSearchProvider['search']) => ({
+    inject: ['web'], apply(ctx: Context) { ctx.web.registerSearchProvider({ id, available: () => true, search }) },
+  })
+  const ctx = await boot('test', join(dir, 'cordis.yml'), readProfilePatches('test', profile), ctx => {
+    ctx.provide('profileContext', profile)
+    Object.assign(ctx.loader.builtins, { editor: ConfigEditor, web: WebRuntime, searxng,
+      official: register('deepseek-official', officialSearch),
+      original: register('custom-original', async () => ({ content: 'original', sources: [], truncated: false })),
+    })
+  })
+  onTestFinished(async () => { vi.unstubAllGlobals(); await ctx.fiber.dispose() })
+  const row = ctx.configEditor.entries().find(row => row.options.id === 'web-search-searxng')!
+  const uid = row.fiber?.uid
+  await ctx.configEditor.edit(row, current => ({ ...current, baseURL: 'http://fixture-searxng.test' }))
+  expect(row.fiber?.uid).toBe(uid)
+  vi.stubGlobal('fetch', vi.fn(async () => new Response('down', { status: 503 })))
+  await expect(ctx.web.search({ query: 'q' })).rejects.toThrow('SearXNG')
+  expect(officialSearch).not.toHaveBeenCalled()
+  await ctx.configEditor.edit(row, current => ({ ...current, allowOfficialFallback: true }))
+  expect((await ctx.web.search({ query: 'q' })).content).toContain('official DeepSeek search')
+  expect(officialSearch).toHaveBeenCalledTimes(1)
+  vi.stubGlobal('fetch', vi.fn(async () => new Response(JSON.stringify({ results: [{ url: 'https://source.test', title: 'SearXNG' }] }), { headers: { 'content-type': 'application/json' } })))
+  expect((await ctx.web.search({ query: 'q' })).sources[0]?.url).toBe('https://source.test')
+  expect(officialSearch).toHaveBeenCalledTimes(1)
+  await ctx.configEditor.edit(row, current => ({ ...current, allowOfficialFallback: false }))
+  vi.stubGlobal('fetch', vi.fn(async () => new Response('down', { status: 503 })))
+  await expect(ctx.web.search({ query: 'q' })).rejects.toThrow('SearXNG')
+  expect(officialSearch).toHaveBeenCalledTimes(1)
+  const removed = planProfileConfigEffects(dir, anchor, ['base'])
+  expect(removed.conflicts).toEqual([])
+  writeFileSync(patchPath, removed.after)
+  const manifest = JSON.parse(readFileSync(join(dir, 'package.json'), 'utf8'))
+  manifest.dsh.profile.bundles = ['base']
+  writeFileSync(join(dir, 'package.json'), JSON.stringify(manifest))
+  rmSync(join(dir, 'node_modules/searxng'), { recursive: true, force: true })
+  await reconcileProfilePatches(ctx, readProfilePatches('test', profile), 'test')
+  expect((await ctx.web.search({ query: 'q' })).content).toBe('original')
+  expect(readFileSync(patchPath, 'utf8')).toBe(original)
+})
